.equ ARM_PERIPHERAL_BASE, 0xFE000000

.equ GPIO_BASE, ARM_PERIPHERAL_BASE + 0x200000
.equ GPIO_FUNC_SEL0_REG, GPIO_BASE          // Function select for pins 1 - 10
.equ GPIO_FUNC_SEL1_REG, GPIO_BASE + 0x4    // Function select for pins 10 - 19
.equ GPIO_PULL_CTRL0_REG, GPIO_BASE + 0xe4  // Pull up/down control register 0

.equ UART0_BASE_ADDR, ARM_PERIPHERAL_BASE + 0x201000
.equ UART0_DATA_REG, UART0_BASE_ADDR + 0x0
.equ UART0_FLAG_REG, UART0_BASE_ADDR + 0x18
.equ UART0_IBRD_REG, UART0_BASE_ADDR + 0x24
.equ UART0_FBRD_REG, UART0_BASE_ADDR + 0x28
.equ UART0_LCRH_REG, UART0_BASE_ADDR + 0x2c
.equ UART0_CTRL_REG, UART0_BASE_ADDR + 0x30
.equ UART0_ICL_REG, UART0_BASE_ADDR + 0x44
